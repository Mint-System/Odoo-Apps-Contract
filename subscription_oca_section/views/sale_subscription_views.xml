<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the subscription form view -->
    <record id="view_sale_subscription_form_inherit" model="ir.ui.view">
        <field name="name">sale.subscription.form.inherit</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="subscription_oca.sale_subscription_form"/> 
        <field name="arch" type="xml">

            <xpath expr="//field[@name='sale_subscription_line_ids']" position="replace">
                <field name="sale_subscription_line_ids" widget="section_and_note_one2many" mode="tree,kanban">
                    <form>
                        <field name="display_type" invisible="1"/>
                        <field name="sequence" invisible="1"/>

                        <group>
                            <!-- Product fields (visible only if not section/note) -->
                            <group invisible="display_type">
                                <field name="product_id" required="not display_type" />
                                <field name="price_total" invisible="1"/>
                                <field name="price_subtotal" invisible="1"/>
                                <field name="product_uom_qty" invisible="1"/>
                                <field name="price_unit" required="True"/>
                                <field name="tax_ids" widget="many2many_tags" />
                                <t groups="product.group_discount_per_so_line">
                                    <label for="discount"/>
                                    <div name="discount">
                                        <field name="discount" class="oe_inline"/> %
                                    </div>
                                </t>
                                <field name="sequence" invisible="1"/> <!-- Required for correct line ordering -->
                            </group>

                            <!-- Section/Note fields (visible only if section/note) -->
                            <group invisible="not display_type">
                                <label for="name" string="Section Name (eg. Products, Services)" invisible="display_type != 'line_section'"/>
                                <label for="name" string="Note" invisible="display_type != 'line_note'"/>
                                <field name="name" required="True" widget="section_and_note_text"/>
                            </group>
                        </group>

                        <!-- Description field (visible only if not section) -->
                        <label for="name" string="Description" invisible="display_type"/>
                        <field name="name" invisible="display_type" required="True" widget="section_and_note_text"/>

                        <field name="company_id" invisible="1"/>
                    </form>
                    <tree editable="bottom">
                        <control>
                            <create name="add_product_control" string="Add a product"/>
                            <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                            <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                        </control>
                        <field name="sequence" widget="handle"/>
                        <!-- We do not display the type because we don't want the user to be bothered with that information if he has no section or note. -->
                        <field name="display_type" column_invisible="True"/>
                        <field name="product_id"/>
                        <field name="name" required="True" widget="section_and_note_text"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="product_uom_qty"/>
                        <field name="price_unit"/>
                        <field name="discount"/>
                        <field name="tax_ids" widget="many2many_tags"/>
                        <field name="price_subtotal" options="{'currency_field': 'currency_id'}"/>
                        <field name="price_total" options="{'currency_field': 'currency_id'}"/>
                    </tree>
                </field>
            </xpath>

            <!-- Also inherit the total group if needed -->
            <xpath expr="//group[@name='subscription_total']" position="after">
                <!-- Optional: Add any additional fields or logic -->
            </xpath>

        </field>
    </record>

</odoo>