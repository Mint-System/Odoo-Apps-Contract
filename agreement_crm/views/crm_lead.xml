<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">agreement_crm.crm_lead_view_form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_create_agreement" type="object"
                    class="oe_stat_button" icon="fa-file-text-o">
                    <div class="o_stat_info">
                        <field name="agreement_count" class="o_stat_value"/>
                        <span class="o_stat_text">Agreements</span>
                    </div>
                </button>
            </div>
            <header position="inside">
                <button name="action_create_agreement" string="New Agreement"
                    type="object" invisible="not active"/>
            </header>
        </field>
    </record>
</odoo>
