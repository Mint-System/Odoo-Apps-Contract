<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agreement_puzzle_agreement_form" model="ir.ui.view">
        <field name="name">agreement.form.inherit.puzzle</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_child_agreements"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="type_code != 'framework'"
                >
                    <field name="child_agreement_count" widget="statinfo" string="Subagreements"/>
                </button>
            </div>
            <field name="agreement_type_id" position="after">
                <field name="parent_agreement_id" invisible="type_code == 'framework'"/>
            </field>
            <field name="end_date" position="before">
                <field name="termination_reminder_date"/>
                <field name="termination_date"/>
            </field>
            <group name="main" position="after">
                <group>
                    <group name="sale" string="Sale">
                        <field name="company_currency_id" readonly="1"/>
                        <field name="yearly_fix_price"/>
                        <field name="hourly_rate"/>
                        <field name="cost_cap"/>
                    </group>
                    <group name="risk" string="Risk">
                        <field name="chances"/>
                        <field name="risk"/>
                    </group>
                </group>
            </group>
            <notebook position="inside">
                <page name="description" string="Description">
                    <field name="description"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
